---
// Experience section with duration-based timeline
---

<section id="experience" class="experience">
  <div class="experience-container">
    <h2>Professional Experience</h2>
    <p class="section-intro">Proven track record in AI engineering and software development</p>

    <div class="experience-timeline">
      <!-- Year markers -->
      <div class="timeline-years">
        <div class="year-marker">2020</div>
        <div class="year-marker">2021</div>
        <div class="year-marker">2022</div>
        <div class="year-marker">2023</div>
        <div class="year-marker">2024</div>
        <div class="year-marker">2025</div>
        <div class="year-marker">2026</div>
      </div>

      <div class="timeline-content">
        <!-- Left Column: Professional Roles -->
        <div class="timeline-column left-column">
          <!-- Silverkey: Jan 2020 - Dec 2022 (3 years) -->
          <div class="experience-block" style="height: 34%; margin-top: 0%;">
            <div class="block-marker"></div>
            <div class="block-content">
              <h3>Machine Learning Engineer</h3>
              <p class="company">Silverkey Technologies – Egypt</p>
              <p class="duration">Jan 2020 — Dec 2022</p>
              <p class="details">
                Published research on vision transformers with Zewail City and ITIDA. 
                Worked on computer vision projects using OpenCV and deep learning. 
                Developed 3D reconstruction systems for image-to-model conversion.
              </p>
            </div>
          </div>

          <!-- Ejada: Jan 2023 - Jan 2024 (1 year) -->
          <div class="experience-block" style="height: 11.5%; margin-top: 2%;">
            <div class="block-marker"></div>
            <div class="block-content">
              <h3>AI Engineer</h3>
              <p class="company">Ejada – Egypt</p>
              <p class="duration">Jan 2023 — Jan 2024</p>
              <p class="details">
                Developed AI models for stock market prediction. Built product interface with NodeJS. 
                Presented project at major Saudi Arabian conference for potential clients.
              </p>
            </div>
          </div>

          <!-- Microsoft: May 2024 - May 2026 (2 years) -->
          <div class="experience-block" style="height: 23%; margin-top: 1%;">
            <div class="block-marker"></div>
            <div class="block-content">
              <h3>Applied AI & Data Scientist</h3>
              <p class="company">Microsoft – Egypt</p>
              <p class="duration">May 2024 — May 2026</p>
              <p class="details">
                Onboarded 10M+ product variants into Azure ML pipelines for product discovery. 
                Designed fine-tuned SLM pipelines to reduce GPT usage costs at scale. 
                Built cross-team PowerBI analytics platform and contributed to Agentic Shopping Platform with multi-agent workflows.
              </p>
            </div>
          </div>

          <!-- Proxify: May 2026 - Present (3 months) -->
          <div class="experience-block" style="height: 2.5%; margin-top: 2%;">
            <div class="block-marker"></div>
            <div class="block-content">
              <h3>Senior AI Engineer</h3>
              <p class="company">Proxify – Sweden</p>
              <p class="duration">May 2026 — Present</p>
              <p class="details">
                Leading architecture and development of an AI-powered performance intelligence platform. 
                Modernized legacy MVP into scalable cloud-native architecture with normalized PostgreSQL schema. 
                Redesigned analytics engine from Ruby to Python/FastAPI microservices, reducing cloud costs by 99%.
              </p>
            </div>
          </div>
        </div>

        <!-- Central timeline line -->
        <div class="timeline-line"></div>

        <!-- Right Column: Teaching Experience -->
        <div class="timeline-column right-column">
          <!-- Session Lead Udacity: Oct 2022 - Sept 2023 (1 year) -->
          <div class="experience-block teaching-block" style="height: 11.5%; margin-top: 25%;">
            <div class="block-marker teaching-marker"></div>
            <div class="block-content">
              <h3>Session Lead</h3>
              <p class="company">Udacity</p>
              <p class="duration">Oct 2022 — Sept 2023</p>
            </div>
          </div>

          <!-- Teaching Assistant Cairo Uni: Feb 2023 - May 2023 (4 months) -->
          <div class="experience-block teaching-block" style="height: 3.5%; margin-top: 1%;">
            <div class="block-marker teaching-marker"></div>
            <div class="block-content">
              <h3>Teaching Assistant</h3>
              <p class="company">Cairo University</p>
              <p class="duration">Feb 2023 — May 2023</p>
            </div>
          </div>

          <!-- Teaching Assistant Nile Uni: Feb 2022 - Aug 2022 (6 months) -->
          <div class="experience-block teaching-block" style="height: 6.9%; margin-top: 8%;">
            <div class="block-marker teaching-marker"></div>
            <div class="block-content">
              <h3>Teaching Assistant</h3>
              <p class="company">Nile University</p>
              <p class="duration">Feb 2022 — Aug 2022</p>
            </div>
          </div>

          <!-- ML Instructor AMIT: Feb 2022 - Mar 2022 (1 month) -->
          <div class="experience-block teaching-block" style="height: 1.15%; margin-top: 1%;">
            <div class="block-marker teaching-marker"></div>
            <div class="block-content">
              <h3>ML Instructor</h3>
              <p class="company">AMIT Learning</p>
              <p class="duration">Feb 2022 — Mar 2022</p>
            </div>
          </div>

          <!-- Master's Degree: 2022 - Now (ongoing) -->
          <div class="experience-block master-block" style="height: 35%; margin-top: 15%;">
            <div class="block-marker master-marker"></div>
            <div class="block-content">
              <h3>Master of Science in Informatics</h3>
              <p class="company">Cairo University</p>
              <p class="duration">2022 — Now</p>
              <p class="details">
                Specialization in Computer Engineering. GPA: 3.1<br>
                Focus: Advanced NLP, Reinforcement Learning, Computer Vision, Neural Networks
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 5rem 1.5rem;
    background: #f8f9fa;
  }

  .experience-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .experience h2 {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 1rem 0;
    color: #0f0f1e;
  }

  .section-intro {
    text-align: center;
    color: #666;
    font-size: 1.125rem;
    margin: 0 0 3rem 0;
  }

  .experience-timeline {
    position: relative;
  }

  .timeline-years {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
    margin-bottom: 2rem;
    text-align: center;
  }

  .year-marker {
    font-size: 0.9rem;
    color: #666;
    font-weight: 600;
  }

  .timeline-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    min-height: 800px;
    position: relative;
  }

  .left-column,
  .right-column {
    display: flex;
    flex-direction: column;
  }

  .timeline-line {
    width: 3px;
    background: linear-gradient(180deg, #64d5ff 0%, #4bb3ff 100%);
    margin: 0 -1.5px;
    box-shadow: 0 0 8px rgba(100, 213, 255, 0.4);
  }

  .experience-block {
    background: white;
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .experience-block:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .block-marker {
    width: 12px;
    height: 12px;
    background: #64d5ff;
    border: 3px solid white;
    border-radius: 50%;
    position: absolute;
    z-index: 2;
    box-shadow: 0 0 0 2px #64d5ff;
  }

  .left-column .block-marker {
    right: -29px;
    top: 50%;
    transform: translateY(-50%);
  }

  .right-column .block-marker {
    left: -29px;
    top: 50%;
    transform: translateY(-50%);
  }

  .teaching-block {
    background: #f0f8ff;
    border-left: 4px solid #64d5ff;
  }

  .teaching-marker {
    background: #a0d5ff;
    box-shadow: 0 0 0 2px #a0d5ff;
  }

  .master-block {
    background: #f5f0ff;
    border-left: 4px solid #9c64ff;
  }

  .master-marker {
    background: #b0a0ff;
    box-shadow: 0 0 0 2px #b0a0ff;
  }

  .block-content {
    position: relative;
  }

  .block-content h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.4rem 0;
    color: #0f0f1e;
  }

  .company {
    color: #64d5ff;
    font-weight: 500;
    margin: 0 0 0.3rem 0;
    font-size: 0.85rem;
  }

  .duration {
    color: #999;
    font-size: 0.8rem;
    margin: 0 0 0.5rem 0;
  }

  .details {
    color: #666;
    line-height: 1.5;
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 1024px) {
    .timeline-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .timeline-line {
      display: none;
    }

    .block-marker {
      display: none;
    }

    .left-column,
    .right-column {
      padding: 0 1rem;
    }

    .experience-block {
      min-height: auto;
      height: auto !important;
      margin-top: 1rem !important;
    }
  }

  @media (max-width: 768px) {
    .experience {
      padding: 3rem 1.5rem;
    }

    .experience h2 {
      font-size: 2rem;
    }

    .timeline-years {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }

    .year-marker {
      font-size: 0.8rem;
    }
  }
</style>

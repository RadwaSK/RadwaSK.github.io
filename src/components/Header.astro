---
// Header component for navigation
---

<header class="header">
  <div class="header-container">
    <div class="logo">
      <h1>
        <a href="/">Radwa Khattab</a>
      </h1>
      <p class="tagline">AI Engineer & Technical Advisor</p>
    </div>
    <nav class="nav">
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 100%);
    color: white;
    padding: 1.5rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .logo h1 a {
    color: white;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .logo h1 a:hover {
    opacity: 0.8;
  }

  .tagline {
    margin: 0.25rem 0 0 0;
    font-size: 0.875rem;
    color: #a0a0b0;
    font-weight: 400;
  }

  .nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav a {
    color: #e0e0e0;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .nav a:hover {
    color: #64d5ff;
  }

  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .nav ul {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>

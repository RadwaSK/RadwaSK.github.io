---
// Selected External Projects — portfolio/technical use cases, not client or employment work

const projects = [
  {
    slug: '/projects/enterprise-modernization',
    title: 'Enterprise Modernization Multi-Agent System',
    summary:
      'A synthetic enterprise modernization assessment system that evaluates legacy applications against engineering standards using evidence-grounded RAG, parallel AI agents, deterministic governance, and human approval.',
    tags: [
      'Python',
      'FastAPI',
      'LangGraph',
      'LangChain',
      'LangSmith',
      'Azure AI Foundry',
      'Azure OpenAI',
      'PostgreSQL',
      'pgvector',
      'React',
      'TypeScript',
      'Docker',
      'GitHub Actions',
    ],
    repo: 'https://github.com/RadwaSK/CDW-UseCase',
    featured: true,
  },
  {
    slug: '/projects/riverpay',
    title: 'RiverPay — Financial Exception Review Workflow',
    summary:
      'A synthetic financial-risk and transaction-review workflow combining AI-assisted evidence collection with deterministic policy enforcement and human escalation.',
    tags: [
      'Python',
      'n8n',
      'LLM Tool Calling',
      'Workflow Automation',
      'KYC Rules',
      'Policy Evaluation',
      'Docker',
      'Structured Decisioning',
    ],
    repo: 'https://github.com/RadwaSK/RiverPay-UseCase',
    featured: false,
  },
];
---

<section id="external-projects" class="work">
  <div class="work-container">
    <h2>Selected External Projects</h2>
    <p class="section-intro">
      Recent hands-on work exploring production-oriented agentic AI, workflow automation, evaluation, and
      governance patterns.
    </p>

    <div class="work-grid">
      {projects.map((project) => (
        <article class={`work-card ${project.featured ? 'work-card-featured' : ''}`}>
          <span class="work-badge">Portfolio Use Case</span>
          <h3>{project.title}</h3>
          <p class="work-summary">{project.summary}</p>
          <div class="work-tags">
            {project.tags.map((tag) => (
              <span class="work-tag">{tag}</span>
            ))}
          </div>
          <div class="work-links">
            <a class="work-link work-link-primary" href={project.slug}>View Case Study</a>
            <a class="work-link work-link-secondary" href={project.repo} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    padding: 5rem 1.5rem;
    background: white;
  }

  .work-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .work h2 {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 1rem 0;
    color: #0f0f1e;
  }

  .section-intro {
    text-align: center;
    color: #666;
    font-size: 1.125rem;
    margin: 0 auto 3rem auto;
    max-width: 700px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .work-card {
    background: #f8f9fa;
    border-radius: 0.75rem;
    padding: 1.75rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(100, 213, 255, 0.15);
  }

  .work-card-featured {
    background: #f0f8ff;
    border: 1px solid rgba(100, 213, 255, 0.4);
    box-shadow: 0 4px 16px rgba(100, 213, 255, 0.15);
  }

  .work-badge {
    display: inline-block;
    align-self: flex-start;
    background: #64d5ff;
    color: #0f0f1e;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    margin-bottom: 0.75rem;
  }

  .work-card h3 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    color: #0f0f1e;
  }

  .work-summary {
    color: #666;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .work-tag {
    font-size: 0.75rem;
    color: #2980b9;
    background: rgba(100, 213, 255, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    font-weight: 500;
  }

  .work-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .work-link {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .work-link-primary {
    background: #64d5ff;
    color: #0f0f1e;
  }

  .work-link-secondary {
    background: transparent;
    color: #0f0f1e;
    border: 1px solid #ccc;
  }

  .work-link:hover {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .work {
      padding: 3rem 1.5rem;
    }

    .work h2 {
      font-size: 2rem;
    }
  }
</style>

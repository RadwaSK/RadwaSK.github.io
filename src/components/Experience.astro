---
// Experience section — timeline scaled to real tenure length

function monthsDiff(a, b) {
  return (b.getFullYear() - a.getFullYear()) * 12 + (b.getMonth() - a.getMonth());
}

const TIMELINE_START = new Date(2020, 0, 1); // Jan 2020
const TIMELINE_END = new Date(2028, 5, 1); // extra room past "Present" so its card has space to breathe
const PX_PER_MONTH = 18;
const TIMELINE_HEIGHT = monthsDiff(TIMELINE_START, TIMELINE_END) * PX_PER_MONTH;

const topPx = (date) => monthsDiff(TIMELINE_START, date) * PX_PER_MONTH;
const spanPx = (start, end) => monthsDiff(start, end) * PX_PER_MONTH;

// Professional roles, oldest first — block height is proportional to real tenure length
const jobs = [
  {
    title: 'Machine Learning Engineer',
    company: 'Silverkey Technologies – Egypt',
    range: 'Jan 2020 — Dec 2022',
    start: new Date(2020, 0, 1),
    end: new Date(2022, 11, 1),
    details:
      'Published research on vision transformers with Zewail City and ITIDA. Worked on computer vision projects using OpenCV and deep learning. Developed 3D reconstruction systems for image-to-model conversion.',
  },
  {
    title: 'AI Engineer',
    company: 'Ejada – Egypt',
    range: 'Jan 2023 — Jan 2024',
    start: new Date(2023, 0, 1),
    end: new Date(2024, 0, 1),
    details:
      'Developed AI models for stock market prediction. Built product interface with NodeJS. Presented project at major Saudi Arabian conference for potential clients.',
  },
  {
    title: 'Applied AI & Data Scientist',
    company: 'Microsoft – Egypt',
    range: 'May 2024 — May 2026',
    start: new Date(2024, 4, 1),
    end: new Date(2026, 4, 1),
    details:
      'Onboarded 10M+ product variants into Azure ML pipelines for product discovery. Designed fine-tuned SLM pipelines to reduce GPT usage costs at scale. Built cross-team PowerBI analytics platform and contributed to Agentic Shopping Platform with multi-agent workflows.',
  },
  {
    title: 'Senior AI Engineer',
    company: 'Proxify – Sweden',
    range: 'May 2026 — Present',
    start: new Date(2026, 4, 1),
    end: TIMELINE_END,
    details:
      'Leading architecture and development of an AI-powered performance intelligence platform. Modernized legacy MVP into scalable cloud-native architecture with normalized PostgreSQL schema. Redesigned analytics engine from Ruby to Python/FastAPI microservices, reducing cloud costs by 99%.',
  },
].map((job) => ({
  ...job,
  top: topPx(job.start),
  height: spanPx(job.start, job.end),
}));

// Year markers on the central line — equal 12-month intervals, aligned to the jobs timeline above
const yearTicks = [2020, 2021, 2022, 2023, 2024, 2025, 2026].map((year) => ({
  year,
  top: topPx(new Date(year, 0, 1)),
}));

// Teaching experience, oldest first — card size scaled relative to each engagement's own length
const teachingRaw = [
  {
    title: 'ML Instructor',
    company: 'AMIT Learning',
    range: 'Feb 2022 — Mar 2022',
    start: new Date(2022, 1, 1),
    end: new Date(2022, 2, 1),
  },
  {
    title: 'Teaching Assistant',
    company: 'Nile University',
    range: 'Feb 2022 — Aug 2022',
    start: new Date(2022, 1, 1),
    end: new Date(2022, 7, 1),
  },
  {
    title: 'Session Lead',
    company: 'Udacity',
    range: 'Oct 2022 — Sept 2023',
    start: new Date(2022, 9, 1),
    end: new Date(2023, 8, 1),
  },
  {
    title: 'Teaching Assistant',
    company: 'Cairo University',
    range: 'Feb 2023 — May 2023',
    start: new Date(2023, 1, 1),
    end: new Date(2023, 4, 1),
  },
];

// Placed on the same calendar scale as the jobs above. Some teaching stints
// overlap in time (Udacity spans Cairo University's stint), so overlapping
// items are split into side-by-side lanes rather than stacked on top of each other.
const laneEnds = [];
const teaching = teachingRaw
  .slice()
  .sort((a, b) => a.start - b.start)
  .map((item) => {
    const startIdx = monthsDiff(TIMELINE_START, item.start);
    const endIdx = monthsDiff(TIMELINE_START, item.end);
    let lane = laneEnds.findIndex((endAt) => endAt <= startIdx);
    if (lane === -1) {
      lane = laneEnds.length;
      laneEnds.push(endIdx);
    } else {
      laneEnds[lane] = endIdx;
    }
    return {
      ...item,
      top: startIdx * PX_PER_MONTH,
      height: (endIdx - startIdx) * PX_PER_MONTH,
      lane,
    };
  });

const TEACHING_LANES = teaching.reduce((max, t) => Math.max(max, t.lane + 1), 1);
teaching.forEach((t) => {
  const laneWidth = 100 / TEACHING_LANES;
  t.leftCss = t.lane === 0 ? '0px' : `calc(${laneWidth * t.lane}% + 0.375rem)`;
  t.widthCss = `calc(${laneWidth}% - 0.375rem)`;
});
---

<section id="experience" class="experience">
  <div class="experience-container">
    <h2>Professional Experience</h2>
    <p class="section-intro">Proven track record in AI engineering and software development</p>

    <div class="experience-timeline" style={`--timeline-height: ${TIMELINE_HEIGHT}px`}>
      {yearTicks.map((tick) => (
        <div class="year-tick" style={`--top: ${tick.top}px`}>
          <span class="year-tick-label">{tick.year}</span>
        </div>
      ))}

      {jobs.map((job) => (
        <div class="experience-item experience-job" style={`--top: ${job.top}px`}>
          <div class="timeline-marker"></div>
          <div class="experience-content" style={`--height: ${job.height}px`}>
            <h3>{job.title}</h3>
            <p class="company">{job.company} | {job.range}</p>
            <p class="details">{job.details}</p>
          </div>
        </div>
      ))}

      <div class="teaching-column">
        {teaching.map((item) => (
          <div
            class="experience-item experience-education"
            style={`--top: ${item.top}px; --left: ${item.leftCss}; --width: ${item.widthCss}`}
          >
            <div class="experience-content education-content" style={`--height: ${item.height}px`}>
              <h3>{item.title}</h3>
              <p class="company">{item.company} | {item.range}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 5rem 1.5rem;
    background: #f8f9fa;
  }

  .experience-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .experience h2 {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 1rem 0;
    color: #0f0f1e;
  }

  .section-intro {
    text-align: center;
    color: #666;
    font-size: 1.125rem;
    margin: 0 0 3rem 0;
  }

  .experience-timeline {
    position: relative;
    padding: 2rem 0;
  }

  .experience-timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 100%;
    background: #64d5ff;
  }

  /* Year markers on the central line */
  .year-tick {
    display: none;
    position: absolute;
    left: 50%;
    top: var(--top);
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  .year-tick-label {
    display: inline-block;
    background: #0f0f1e;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.15rem 0.5rem;
    border-radius: 1rem;
    border: 2px solid #64d5ff;
    white-space: nowrap;
  }

  .experience-item {
    position: relative;
  }

  .timeline-marker {
    width: 16px;
    height: 16px;
    background: #64d5ff;
    border: 4px solid #f8f9fa;
    border-radius: 50%;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0.25rem;
    z-index: 2;
  }

  .experience-content {
    background: white;
    padding: 1.75rem;
    border-radius: 0.75rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .experience-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: #0f0f1e;
  }

  .company {
    color: #64d5ff;
    font-weight: 500;
    margin: 0 0 1rem 0;
    font-size: 0.95rem;
  }

  .details {
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  .experience-item.experience-education .experience-content.education-content {
    background: #f0f8ff;
    border-left: 4px solid #64d5ff;
  }

  .experience-item.experience-education .experience-content.education-content h3 {
    color: #1a5a8f;
  }

  .experience-item.experience-education .company {
    color: #2980b9;
  }

  .experience-note {
    text-align: center;
    margin-top: 3rem;
    padding: 1.5rem;
    background: white;
    border-radius: 0.75rem;
    color: #666;
  }

  /* Desktop: jobs are placed by real calendar position on the left,
     card height reflects real tenure length, years tick the shared line. */
  @media (min-width: 769px) {
    .experience-timeline {
      min-height: var(--timeline-height);
    }

    .year-tick {
      display: block;
    }

    .experience-item.experience-job {
      position: absolute;
      top: var(--top);
      left: 0;
      right: 0;
      margin-bottom: 0;
    }

    .experience-item.experience-job .experience-content {
      margin-right: calc(50% + 1rem);
      min-height: var(--height);
    }

    .teaching-column {
      position: absolute;
      top: 0;
      right: 0;
      width: calc(50% - 1rem);
      height: 100%;
    }

    .teaching-column .experience-item.experience-education {
      position: absolute;
      top: var(--top);
      left: var(--left);
      width: var(--width);
    }

    .teaching-column .experience-content {
      min-height: var(--height);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .experience {
      padding: 3rem 1.5rem;
    }

    .experience h2 {
      font-size: 2rem;
    }

    .experience-timeline::before {
      left: 16px;
    }

    .experience-item.experience-job {
      margin-bottom: 2rem;
    }

    .experience-item.experience-job .timeline-marker {
      left: 16px;
    }

    .experience-item.experience-job .experience-content {
      margin-left: 60px;
    }

    .teaching-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .teaching-column .experience-item.experience-education {
      width: auto;
    }

    .teaching-column .experience-content {
      margin-left: 60px;
    }
  }
</style>

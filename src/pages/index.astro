---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Background from '../components/Background.astro';
import WorkStyle from '../components/WorkStyle.astro';
import Contact from '../components/Contact.astro';
import '../styles/global.css';

const title = 'Radwa Khattab | Senior AI Engineer & Data Scientist';
const description = 'Production AI Engineering, LLMs, MLOps, Cloud Architecture, and Technical Leadership. Available for freelance projects and consulting.';
const ogImage = 'https://radwakhattab.github.io/og-image.png';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://radwakhattab.github.io/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://radwakhattab.github.io/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />
		
		<!-- Additional Meta Tags -->
		<meta name="theme-color" content="#64d5ff" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href="https://radwakhattab.github.io/" />
		
		<!-- Preconnect to external resources -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	</head>
	<body>
		<Header />
		<main>
			<Hero />
			<Services />
			<Skills />
			<Experience />
			<Background />
			<WorkStyle />
			<Contact />
		</main>
		<footer class="footer">
			<div class="footer-content">
				<p>&copy; 2026 Radwa Khattab. All rights reserved.</p>
				<p class="footer-note">
					Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> with AI Agent assistance, 
					deployed on <a href="https://pages.github.com/" target="_blank" rel="noopener noreferrer">GitHub Pages</a>.
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		padding: 0;
	}

	main {
		min-height: 100vh;
	}

	.footer {
		background: #0f0f1e;
		color: #b0b0c0;
		padding: 3rem 1.5rem;
		text-align: center;
		border-top: 1px solid rgba(100, 213, 255, 0.2);
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer p {
		margin: 0.5rem 0;
		font-size: 0.9rem;
	}

	.footer a {
		color: #64d5ff;
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	.footer a:hover {
		opacity: 0.8;
		text-decoration: underline;
	}

	.footer-note {
		font-size: 0.85rem;
		color: #8080a0;
	}
</style>

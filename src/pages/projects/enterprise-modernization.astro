---
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import '../../styles/global.css';

const title = 'Enterprise Modernization Multi-Agent System | Radwa Khattab';
const description =
  'A synthetic portfolio use case: an agentic AI reference architecture for assessing legacy applications against engineering standards using evidence-grounded RAG, LangGraph orchestration, deterministic governance, and human-in-the-loop approval.';
const canonicalUrl = 'https://radwask.github.io/projects/enterprise-modernization';
const ogImage = 'https://radwask.github.io/og-image.png';
const repoUrl = 'https://github.com/RadwaSK/CDW-UseCase';

const architectureGroups = [
  {
    title: 'Orchestration',
    points: [
      'LangGraph orchestration across the multi-agent workflow',
      'Parallel architecture and security analyst agents',
      'A modernization planner agent that synthesizes findings into a plan',
      'A bounded revision loop, capped rather than open-ended',
    ],
  },
  {
    title: 'Retrieval',
    points: [
      'Code and engineering-standard ingestion into a structured knowledge base',
      'PostgreSQL + pgvector retrieval over ingested standards and application evidence',
      'Retrieval-augmented generation over the retrieved application and standards evidence',
    ],
  },
  {
    title: 'Evidence Grounding',
    points: [
      'Evidence explicitly attached to every finding',
      'File path and line-level citations for traceability back to source',
      'A deterministic evidence reviewer that mechanically checks findings against retrieved chunks',
    ],
  },
  {
    title: 'Human Control',
    points: [
      'Checkpointed workflow state with pause/resume for long-running assessments',
      'Explicit human approval gate before any consequential action',
    ],
  },
  {
    title: 'Integration',
    points: [
      'FastAPI backend with a React / TypeScript frontend',
      'Mocked ServiceNow ticket creation for change-management follow-up',
    ],
  },
  {
    title: 'Engineering',
    points: [
      'Docker for local/dev environments',
      'GitHub Actions for CI, including the evaluation and regression suite',
      'Audit-oriented tracing of agent runs',
    ],
  },
];

const governancePoints = [
  'Every finding requires attached evidence — no evidence, no finding',
  'Citation IDs are mechanically checked against retrieved chunks, not just asserted by the model',
  'Unsupported claims are removed rather than surfaced to the user',
  'Approval rules are deterministic (rule-based), not left to LLM judgment',
  'Any consequential action requires explicit human approval',
  'Ticket creation is idempotent and fully mocked — no real ticketing system is touched',
  'Traces stored in PostgreSQL are sanitized before persistence',
  'LangSmith is used only for development/demo observability, not production monitoring',
  'Agent work is bounded by retrieval and revision limits to prevent runaway loops',
];

const evalPoints = [
  'A golden evaluation dataset of representative assessment scenarios',
  'Offline, deterministic evaluation — not relying on live LLM judging alone',
  'CI regression checks that run on relevant changes',
  'Testing of risk classification against expected outcomes',
  'Testing of the approval policy logic',
  'Evidence coverage checks (are findings actually grounded?)',
  'Tool safety checks around the mocked ticketing action',
  'GitHub Actions running the evaluation and regression suite',
  'LangSmith used for development/debugging observability, not as a production SLA metric',
];

const limitations = [
  'No production authentication/authorization — this is a demo-grade access model',
  'Change-management integration (ServiceNow) is mocked end-to-end',
  'Retrieval corpus is sample-scale, not a full enterprise codebase',
  'Assessment execution is synchronous in this reference implementation',
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Header />
    <main>
      <section class="case-hero">
        <div class="case-hero-inner">
          <span class="case-badge">Synthetic Portfolio Use Case</span>
          <h1>Enterprise Modernization Multi-Agent System</h1>
          <p class="case-lede">
            An enterprise-oriented agentic AI reference architecture for assessing legacy applications against
            engineering standards while keeping evidence, approvals, and consequential actions explicitly
            controlled.
          </p>
          <a class="repo-button" href={repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>
        </div>
      </section>

      <section class="case-section">
        <div class="case-container">
          <h2>Problem</h2>
          <p>
            Automated modernization assessment — using AI to review legacy applications against engineering
            standards — creates two major risks that most naive implementations ignore:
          </p>
          <ol class="problem-list">
            <li>AI-generated findings may not actually be grounded in source evidence.</li>
            <li>AI systems should not be allowed to autonomously perform consequential change-management actions.</li>
          </ol>
          <p>This system was designed around those two risks from the ground up, rather than bolting on safety after the fact.</p>
        </div>
      </section>

      <section class="case-section case-section-alt">
        <div class="case-container">
          <h2>Architecture &amp; Technical Highlights</h2>
          <div
            class="architecture-diagram"
            role="img"
            aria-label="Two entry paths feed the system: sample repositories and engineering standards are chunked, embedded, and stored in a PostgreSQL + pgvector evidence store; the client React/TypeScript UI calls the FastAPI API, which starts the LangGraph assessment workflow. The workflow retrieves evidence from pgvector, runs architecture and security analyst agents in parallel, passes their findings to a modernization planner, then to a deterministic evidence reviewer, which sends work back to the planner for a bounded, capped number of revisions if evidence is insufficient. The reviewed plan goes to a deterministic approval policy: if no approval is required, it produces the final assessment report directly; if approval is required, a human reviewer approves or rejects it — approval triggers a mocked ServiceNow change-ticket adapter before the final report, rejection goes straight to the final report. Secondary, dashed paths show LangGraph checkpoints and sanitized execution traces persisting in PostgreSQL for resume and audit, and optional LangSmith observability for development and demo use only, with no control over workflow decisions.">
            <div class="diagram-legend">
              <span class="legend-item"><span class="legend-swatch legend-solid"></span>Core assessment flow</span>
              <span class="legend-item"><span class="legend-swatch legend-dashed"></span>Persistence &amp; optional observability — no decision control</span>
            </div>

            <div class="diagram-stage">
              <span class="stage-label">Evidence Ingestion <em>(synthetic sample data)</em></span>
              <div class="diagram-row">
                <div class="diagram-box">Sample repositories +<br />engineering standards</div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box">Ingestion pipeline<br /><span>chunking + embeddings</span></div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box diagram-box-store">PostgreSQL + pgvector<br /><span>searchable evidence store</span></div>
              </div>
            </div>

            <div class="diagram-stage">
              <span class="stage-label">User Request</span>
              <div class="diagram-row">
                <div class="diagram-box">Client React /<br />TypeScript UI</div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box">FastAPI API</div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box">LangGraph<br />assessment workflow</div>
              </div>
            </div>

            <div class="diagram-stage">
              <span class="stage-label">Assessment Workflow (LangGraph)</span>
              <div class="diagram-row diagram-row-wrap">
                <div class="diagram-box">Retrieve evidence<br /><span>from pgvector</span></div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box-pair">
                  <div class="diagram-box">Architecture<br />analyst</div>
                  <div class="diagram-box">Security<br />analyst</div>
                </div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box">Modernization<br />planner</div>
                <div class="diagram-arrow">→</div>
                <div class="diagram-box">Evidence reviewer<br /><span>deterministic validation</span></div>
              </div>
              <div class="diagram-loop">↺ bounded revision loop (capped) back to the planner when evidence is insufficient</div>
              <div class="diagram-row">
                <div class="diagram-arrow diagram-arrow-down">↓</div>
              </div>
              <div class="diagram-row">
                <div class="diagram-box diagram-box-gate">Deterministic approval policy</div>
              </div>
            </div>

            <div class="diagram-stage">
              <span class="stage-label">Outcome</span>
              <div class="outcome-branches">
                <div class="outcome-branch">
                  <span class="branch-label">No approval required</span>
                  <div class="diagram-arrow diagram-arrow-down">↓</div>
                  <div class="diagram-box diagram-box-muted">Final assessment report</div>
                </div>
                <div class="outcome-branch outcome-branch-wide">
                  <span class="branch-label">Approval required</span>
                  <div class="diagram-arrow diagram-arrow-down">↓</div>
                  <div class="diagram-box">Human approval decision</div>
                  <div class="branch-split">
                    <div class="branch-split-item">
                      <span class="branch-label">Approved</span>
                      <div class="diagram-arrow diagram-arrow-down">↓</div>
                      <div class="diagram-box">Mocked ServiceNow<br /><span>change-ticket adapter</span></div>
                      <div class="diagram-arrow diagram-arrow-down">↓</div>
                      <div class="diagram-box diagram-box-muted">Final assessment report</div>
                    </div>
                    <div class="branch-split-item">
                      <span class="branch-label">Rejected</span>
                      <div class="diagram-arrow diagram-arrow-down">↓</div>
                      <div class="diagram-box diagram-box-muted">Final assessment report</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="diagram-stage diagram-stage-secondary">
              <span class="stage-label">Persistence &amp; Observability <em>(secondary paths)</em></span>
              <div class="diagram-row diagram-row-wrap">
                <div class="diagram-box diagram-box-dashed">LangGraph checkpoints<br /><span>resume after approval or recovery</span></div>
                <div class="diagram-box diagram-box-dashed">Sanitized<br />execution traces</div>
                <div class="diagram-box diagram-box-dashed diagram-box-store">PostgreSQL<br /><span>assessments, reports, tickets, checkpoints &amp; traces</span></div>
                <div class="diagram-box diagram-box-dashed diagram-box-optional">LangSmith<br /><span>optional demo/dev observability — no decision control</span></div>
              </div>
            </div>
          </div>
          <div class="capability-groups">
            {architectureGroups.map((group) => (
              <div class="capability-group">
                <h3>{group.title}</h3>
                <ul class="feature-list">
                  {group.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <p class="note">
            Orchestrated end-to-end with LangGraph. All sample applications, findings, and evidence shown here are
            synthetic; the ServiceNow step is a mocked adapter, not a live integration.
          </p>

          <div class="callout">
            <span class="callout-label">Key Design Decision</span>
            <p>
              I intentionally separated model reasoning from evidence and approval enforcement. Agents can
              analyze and propose, while deterministic components validate evidence and control consequential
              actions.
            </p>
          </div>
        </div>
      </section>

      <section class="case-section">
        <div class="case-container">
          <h2>Governance &amp; Safety</h2>
          <ul class="feature-list">
            {governancePoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>

      <section class="case-section case-section-alt">
        <div class="case-container">
          <h2>Evaluation &amp; LLMOps</h2>
          <ul class="feature-list">
            {evalPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>

      <section class="case-section">
        <div class="case-container">
          <h2>Limitations &amp; Disclosure</h2>
          <div class="disclosure-box">
            <p>
              <strong>This is a synthetic portfolio use case.</strong> All applications, findings, CMDB context,
              and change tickets are synthetic. The ServiceNow integration is mocked. It is not customer delivery
              and does not access or modify real enterprise systems.
            </p>
          </div>
          <p>Additional demo-scope limitations from the repository:</p>
          <ul class="feature-list">
            {limitations.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>

      <section class="case-section case-repo-cta">
        <div class="case-container case-repo-cta-inner">
          <h2>Repository</h2>
          <p>Explore the full implementation, including the agent graph, evidence pipeline, and evaluation harness.</p>
          <a class="repo-button" href={repoUrl} target="_blank" rel="noopener noreferrer">View CDW-UseCase on GitHub</a>
        </div>
      </section>
    </main>
    <Contact />
    <footer class="footer">
      <div class="footer-content">
        <p>&copy; 2026 Radwa Khattab. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
  }

  .case-hero {
    background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 100%);
    color: white;
    padding: 4.5rem 1.5rem;
    text-align: center;
  }

  .case-hero-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .case-badge {
    display: inline-block;
    background: #64d5ff;
    color: #0f0f1e;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    margin-bottom: 1.25rem;
  }

  .case-hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1.25rem 0;
    line-height: 1.2;
  }

  .case-lede {
    font-size: 1.15rem;
    color: #c0c0d0;
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .repo-button {
    display: inline-block;
    background: #64d5ff;
    color: #0f0f1e;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .repo-button:hover {
    opacity: 0.85;
  }

  .case-section {
    padding: 3.5rem 1.5rem;
    background: white;
  }

  .case-section-alt {
    background: #f8f9fa;
  }

  .case-container {
    max-width: 850px;
    margin: 0 auto;
  }

  .case-section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f0f1e;
    margin: 0 0 1.25rem 0;
  }

  .case-section p {
    color: #444;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  .problem-list {
    color: #444;
    line-height: 1.7;
    padding-left: 1.25rem;
  }

  .problem-list li {
    margin-bottom: 0.5rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .feature-list li {
    color: #444;
    line-height: 1.6;
    padding: 0.75rem 1rem;
    background: white;
    border-left: 3px solid #64d5ff;
    border-radius: 0.35rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  .case-section-alt .feature-list li {
    background: #ffffff;
  }

  .note {
    font-size: 0.9rem;
    color: #888;
    font-style: italic;
    margin-top: 1.25rem;
  }

  .capability-groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .capability-group h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a5a8f;
    margin: 0 0 0.6rem 0;
  }

  .capability-group .feature-list {
    gap: 0.5rem;
  }

  .capability-group .feature-list li {
    font-size: 0.9rem;
    padding: 0.6rem 0.85rem;
  }

  .callout {
    background: #f0f8ff;
    border-left: 4px solid #64d5ff;
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    margin-top: 2rem;
  }

  .callout-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #1a5a8f;
    margin-bottom: 0.5rem;
  }

  .callout p {
    margin: 0;
    color: #1a5a8f;
    line-height: 1.6;
  }

  .architecture-diagram {
    background: #0f0f1e;
    border-radius: 0.75rem;
    padding: 1.75rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .diagram-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(100, 213, 255, 0.15);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #a0a0b0;
  }

  .legend-swatch {
    display: inline-block;
    width: 1.5rem;
    height: 0;
    border-top: 2px solid #64d5ff;
  }

  .legend-swatch.legend-dashed {
    border-top-style: dashed;
    opacity: 0.7;
  }

  .diagram-stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stage-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64d5ff;
  }

  .stage-label em {
    font-style: normal;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: #7a7a90;
  }

  .diagram-stage-secondary {
    padding-top: 1rem;
    border-top: 1px dashed rgba(100, 213, 255, 0.25);
  }

  .diagram-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .diagram-row-wrap {
    flex-wrap: wrap;
  }

  .diagram-box-pair {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .diagram-box {
    background: #1a1a2e;
    border: 1px solid rgba(100, 213, 255, 0.4);
    color: #e0e0e0;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.4;
  }

  .diagram-box span {
    display: block;
    font-weight: 400;
    color: #a0a0b0;
    font-size: 0.75rem;
    margin-top: 0.15rem;
  }

  .diagram-box-gate {
    border-color: #64d5ff;
    background: rgba(100, 213, 255, 0.15);
    color: #64d5ff;
  }

  .diagram-box-muted {
    opacity: 0.7;
    font-style: italic;
  }

  .diagram-box-store {
    border-color: rgba(100, 213, 255, 0.6);
    box-shadow: inset 0 0 0 1px rgba(100, 213, 255, 0.15);
  }

  .diagram-box-dashed {
    border-style: dashed;
    background: transparent;
    opacity: 0.85;
  }

  .diagram-box-optional {
    opacity: 0.65;
  }

  .diagram-arrow {
    color: #64d5ff;
    font-size: 1.25rem;
  }

  .diagram-arrow-down {
    font-size: 1rem;
  }

  .diagram-loop {
    align-self: center;
    font-size: 0.75rem;
    color: #a0a0b0;
    text-align: center;
    max-width: 30rem;
  }

  .outcome-branches {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    justify-content: center;
  }

  .outcome-branch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .branch-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #64d5ff;
  }

  .branch-split {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .branch-split-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .disclosure-box {
    background: #fff8e1;
    border-left: 4px solid #e6a817;
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .disclosure-box p {
    margin: 0;
    color: #6b5a1e;
  }

  .case-repo-cta {
    background: #0f0f1e;
    text-align: center;
  }

  .case-repo-cta-inner h2 {
    color: white;
  }

  .case-repo-cta-inner p {
    color: #c0c0d0;
    margin-bottom: 1.75rem;
  }

  .footer {
    background: #0f0f1e;
    color: #b0b0c0;
    padding: 2rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(100, 213, 255, 0.2);
  }

  .footer p {
    margin: 0;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .case-hero {
      padding: 3rem 1.5rem;
    }

    .case-hero h1 {
      font-size: 1.85rem;
    }

    .diagram-row {
      flex-direction: column;
    }

    .diagram-row .diagram-arrow:not(.diagram-arrow-down) {
      transform: rotate(90deg);
    }

    .outcome-branches,
    .branch-split {
      gap: 2rem;
    }

    .capability-groups {
      grid-template-columns: 1fr;
    }
  }
</style>
